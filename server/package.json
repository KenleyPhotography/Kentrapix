{
  "name": "kentrapix-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend KentraPix — API Node.js/Express + PostgreSQL (Supabase)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/db-init.js",
    "db:migrate": "node scripts/db-migrate.js",
    "create-admin": "node scripts/create-admin.js",
    "push:keys": "node scripts/push-keys.js",
    "storage:setup": "node scripts/storage-setup.js",
    "storage:migrate": "node scripts/storage-migrate.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^3.25.0"
  }
}
