# Copiez ce fichier en .env puis remplissez les valeurs.
# Ne partagez JAMAIS le fichier .env (il contient vos mots de passe).

NODE_ENV=development
PORT=3000

# Base de données PostgreSQL (Supabase) : bouton « Connect » > Connection string > « Session pooler » (IPv4).
DATABASE_URL=
# Facultatif : certificat SSL Supabase (connexion vérifiée), ex. supabase-ca.crt
DATABASE_CA=


# Secret de signature des sessions : au moins 32 caractères aléatoires.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Durée de session (jours). « Se souvenir de moi » = 30 jours.
SESSION_DAYS=7

# Dossier PRIVÉ des photos (originaux + aperçus). Relatif au dossier server/.
STORAGE_DIR=storage

# Taille max par photo importée (Mo) et largeur des aperçus (px).
MAX_UPLOAD_MB=50
PREVIEW_WIDTH=1600

# true si le site est derrière un proxy (Nginx, Render, Railway…) pour
# que la limitation des tentatives de connexion voie la vraie IP.
TRUST_PROXY=false

# Adresse publique du site (liens dans les e-mails). En production : https://votre-domaine.com
APP_URL=http://localhost:3000

# Autres sites autorisés à appeler l'API (CORS), séparés par des virgules.
# Vide = seules les pages de ce site peuvent l'appeler (c'est le cas normal : le site,
# l'application Android et l'application de bureau ouvrent tous la même adresse).
CORS_ORIGINS=

# E-mails automatiques via Resend (https://resend.com/api-keys).
# Laissez vide pour désactiver l'envoi (les e-mails sont alors notés « non envoyé »).
RESEND_API_KEY=
# Expéditeur : un domaine vérifié dans Resend, ex. "Kenley Photography <photos@votre-domaine.com>".
# Pour tester sans domaine : "KentraPix <onboarding@resend.dev>" (envoie seulement à l'e-mail de votre compte Resend).
MAIL_FROM=
# Adresse qui reçoit les réponses des clients (facultatif).
MAIL_REPLY_TO=

# Photos en ligne (facultatif) : Backblaze B2 ou tout stockage compatible S3 (R2, Oracle...).
# Rempli = les photos vont directement du navigateur au bucket, jamais sur ce serveur.
# Vide = photos dans STORAGE_DIR. Après remplissage : npm run storage:setup puis npm run storage:migrate
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
# Endpoint S3 du bucket, ex. s3.us-east-005.backblazeb2.com
B2_ENDPOINT=
