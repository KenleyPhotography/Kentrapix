{
  "name": "kentrapix-desktop",
  "productName": "KentraPix",
  "version": "1.0.0",
  "description": "KentraPix pour ordinateur",
  "main": "main.js",
  "author": "Kenley Elysée",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kenleyelysee.kentrapix",
    "productName": "KentraPix",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "offline.html", "icon.png"],
    "win": { "target": "nsis", "icon": "icon.png" },
    "mac": { "target": "dmg", "icon": "icon.png", "category": "public.app-category.photography" },
    "linux": { "target": ["AppImage"], "icon": "icon.png", "category": "Graphics" }
  }
}
